# Reference for every variable the Docker stack reads.
#
# This file is tracked and contains NO real values. `scripts/setup.sh` writes
# deploy/.env with generated secrets; that file is ignored and must never be
# committed — scripts/check-secrets.sh refuses it.
#
# Nothing here is branch-specific by design. main and dev share exactly the
# same tracked configuration, so merging one into the other never conflicts
# over environment values.

# ── which components run ──────────────────────────────────────────────
# Keycloak, LiteLLM, Ollama and headroom are Compose profiles. Compose reads
# this variable from here, so `docker compose up` starts exactly the listed
# services plus the four that are not optional: postgres, init, gateway and
# indexer. Leave it empty to run only those.
#
# scripts/wizard.sh writes this line from a few questions; editing it by hand
# works just as well.
COMPOSE_PROFILES=keycloak,litellm,ollama

# ── database ──────────────────────────────────────────────────────────
# The Compose stack ships PostgreSQL, so this works with nothing external.
# To use your own instance, set DATABASE_URL and start with
#   docker compose up -d --scale postgres=0
POSTGRES_USER=repomcp
POSTGRES_PASSWORD=
POSTGRES_DB=repomcp
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://user:password@db.internal:5432/repomcp

# Encrypts provider tokens at rest. Must be stable across restarts and
# identical on every replica; losing it means re-entering every credential.
#   make generate-key
SECRETS_KEY=

# The first administrator, created on first start. Leave the password empty
# and one is generated and printed once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# How often a service re-checks whether an administrator changed something.
CONFIG_POLL_SECONDS=15

# ── generated secrets ─────────────────────────────────────────────────
# scripts/setup.sh generates these. To do it by hand:
#   openssl rand -hex 24
LITELLM_MASTER_KEY=
CI_TRIGGER_TOKEN=
WEBHOOK_SECRET_GITHUB=
WEBHOOK_SECRET_GITLAB=
WEBHOOK_SECRET_BITBUCKET=
KEYCLOAK_ADMIN_PASSWORD=

# ── provider tokens for repository discovery ──────────────────────────
# Read-only scopes are enough: the indexer clones and lists, it never writes.
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_APP_PASSWORD=

# ── identity ──────────────────────────────────────────────────────────
# OIDC settings now live in the database and are changed through the admin
# API (or `repo-mcp-admin set oidc.issuer '"https://..."'`). Only the
# development bypass remains an environment variable.

# Local evaluation without Keycloak. Never enable in production — the gateway
# logs a warning when it is on.
DEV_INSECURE_AUTH=false
DEV_STATIC_TOKEN=
DEV_STATIC_GROUPS=

# ── model backend ─────────────────────────────────────────────────────
# The model and base URL are database settings now (litellm.model,
# litellm.base_url). These configure the bundled LiteLLM container itself.
OLLAMA_BASE_URL=http://ollama:11434

# Optional, when LiteLLM routes to a hosted provider or a vLLM server.
OPENAI_API_KEY=
VLLM_BASE_URL=
VLLM_API_KEY=

# ── engine ────────────────────────────────────────────────────────────
# Pin this in production: all engine processes sharing a cache root must run
# the same build, or they fail with a version cohort conflict.
CBM_VERSION=latest

# ── tuning ────────────────────────────────────────────────────────────

# ── resource limits ───────────────────────────────────────────────────
GATEWAY_MEMORY_LIMIT=4g
INDEXER_MEMORY_LIMIT=8g
OLLAMA_MEMORY_LIMIT=16g

# --- prompt compression (optional) ---
# Headroom sits in front of LiteLLM and compresses the evidence sent to the
# model. Pin the version: updating it is bumping this tag, and rolling back is
# the previous one. Start it with:  docker compose --profile headroom up -d
# Then:  repo-mcp-admin set headroom.base_url http://headroom:8787/v1
#        repo-mcp-admin set headroom.enabled true
# See docs/adr/0010-headroom-plugin.md.
HEADROOM_VERSION=latest
HEADROOM_UPSTREAM_URL=http://litellm:4000/v1
HEADROOM_OUTPUT_SHAPER=1
